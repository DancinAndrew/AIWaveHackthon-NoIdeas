# ---- AWS ----
AWS_REGION=us-west-2

# ---- Bedrock ----
# 這個 workshop 帳號實測可用：us.anthropic.claude-haiku-4-5-20251001-v1:0
# 備選：us.amazon.nova-pro-v1:0 / us.amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ---- 資料層 ----
# memory = 本地記憶體（不需 AWS 資源，適合先跑通流程）
# dynamodb = 真的打 DynamoDB
REPO_DRIVER=memory
TABLE_NAME=op-life-agent

# ---- Agent 間呼叫 ----
# 留空 = 本地 in-process 直接呼叫 match agent
# 有值 = 用 Lambda invoke 呼叫（部署後由 CDK 注入）
MATCH_FUNCTION_NAME=

# ---- 本地開發 ----
PORT=3001

# ---- RDS PostgreSQL ----
# 這幾個變數會由 packages/api/scripts/rds_create.py 自動寫進 .env，不用手填。
# 變數名沿用 PostgreSQL 官方慣例，psql / DBeaver 也認得。
# PGPASSWORD 是機密，.env 已被 gitignore，不要 commit、不要貼到聊天室。
PGHOST=
PGPORT=5432
PGDATABASE=oplifeagent
PGUSER=opadmin
PGPASSWORD=
