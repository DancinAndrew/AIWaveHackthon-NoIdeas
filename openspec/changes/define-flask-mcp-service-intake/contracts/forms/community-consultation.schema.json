{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwave.example/schemas/forms/community-consultation/1.0.0",
  "title": "社區服務諮詢留資表單",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_type",
    "schema_version",
    "request_summary",
    "contact",
    "preferred_contact_time",
    "consent",
    "community"
  ],
  "properties": {
    "service_type": { "const": "community_consultation" },
    "schema_version": { "const": "1.0.0" },
    "request_summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "mobile": { "type": "string", "minLength": 8, "maxLength": 30 },
        "email": { "type": "string", "format": "email", "maxLength": 254 }
      },
      "anyOf": [
        { "required": ["mobile"] },
        { "required": ["email"] }
      ]
    },
    "preferred_contact_time": {
      "type": "string",
      "enum": ["morning", "afternoon", "evening", "any"]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy_policy_version", "accepted", "accepted_at"],
      "properties": {
        "privacy_policy_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "accepted": { "const": true },
        "accepted_at": { "type": "string", "format": "date-time" }
      }
    },
    "community": {
      "type": "object",
      "additionalProperties": false,
      "required": ["community_name", "location", "issue_category", "description", "urgency", "anonymity_preference"],
      "properties": {
        "community_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["county_code", "district_code"],
          "properties": {
            "county_code": { "type": "string", "minLength": 1, "maxLength": 10 },
            "district_code": { "type": "string", "minLength": 1, "maxLength": 20 }
          }
        },
        "issue_category": {
          "type": "string",
          "enum": ["facility", "noise", "parking", "security", "administration", "fee", "package", "neighbor_dispute", "other"]
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "urgency": {
          "type": "string",
          "enum": ["routine", "soon", "urgent", "emergency"]
        },
        "affected_area": { "type": "string", "maxLength": 300 },
        "responsible_unit_hint": { "type": "string", "maxLength": 200 },
        "preferred_resolution": { "type": "string", "maxLength": 1000 },
        "anonymity_preference": {
          "type": "string",
          "enum": ["show_contact_to_candidates", "mask_until_accepted"]
        },
        "attachments": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "maxLength": 2048 }
        }
      }
    }
  }
}
