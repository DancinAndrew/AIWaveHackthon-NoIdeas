{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwave.example/schemas/forms/product-purchase/1.0.0",
  "title": "商品購買留資表單",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_type",
    "schema_version",
    "request_summary",
    "contact",
    "preferred_contact_time",
    "consent",
    "product"
  ],
  "properties": {
    "service_type": { "const": "product_purchase" },
    "schema_version": { "const": "1.0.0" },
    "request_summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "mobile": { "type": "string", "minLength": 8, "maxLength": 30 },
        "email": { "type": "string", "format": "email", "maxLength": 254 }
      },
      "anyOf": [
        { "required": ["mobile"] },
        { "required": ["email"] }
      ]
    },
    "preferred_contact_time": {
      "type": "string",
      "enum": ["morning", "afternoon", "evening", "any"]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy_policy_version", "accepted", "accepted_at"],
      "properties": {
        "privacy_policy_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "accepted": { "const": true },
        "accepted_at": { "type": "string", "format": "date-time" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "category",
        "budget",
        "quantity",
        "delivery",
        "accept_substitutes"
      ],
      "properties": {
        "query": { "type": "string", "minLength": 1, "maxLength": 500 },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_amount", "currency"],
          "properties": {
            "max_amount": { "type": "number", "minimum": 0, "maximum": 10000000 },
            "currency": { "const": "TWD" }
          }
        },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 999 },
        "brand_preferences": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "required_specs": {
          "type": "object",
          "maxProperties": 30,
          "additionalProperties": {
            "type": ["string", "number", "boolean"],
            "maxLength": 200
          }
        },
        "accept_substitutes": { "type": "boolean" },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["county_code", "district_code", "flexibility"],
          "properties": {
            "county_code": { "type": "string", "minLength": 1, "maxLength": 10 },
            "district_code": { "type": "string", "minLength": 1, "maxLength": 20 },
            "needed_by": { "type": "string", "format": "date-time" },
            "flexibility": { "type": "string", "enum": ["exact", "within_3_days", "flexible"] }
          }
        }
      }
    }
  }
}
